{
  "name": "SAGE Lab (HugoBlox)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22",
      "pnpmVersion": "10.14.0"
    },
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "0.162.0",
      "extended": true
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },
  "updateContentCommand": "sudo chown -R vscode:vscode /workspaces/lab/node_modules /home/vscode/.local/share/pnpm && CI=true pnpm install --frozen-lockfile --prefer-offline",
  "postCreateCommand": "pnpm --version && hugo version",
  "customizations": {
    "vscode": {
      "extensions": [
        "ownable.ownable"
      ]
    }
  },
  "mounts": [
    "source=pnpm-store,target=/home/vscode/.local/share/pnpm,type=volume",
    "source=sage-lab-node-modules,target=/workspaces/lab/node_modules,type=volume"
  ],
  "remoteUser": "vscode",
  "forwardPorts": [
    1313
  ],
  "portsAttributes": {
    "1313": {
      "label": "Hugo Server"
    }
  }
}
